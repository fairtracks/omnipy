# Temporary workaround for https://github.com/nolabs-ai/nono/issues/1652,
# when running Omnipy tests in a nono sandbox with network proxy on Linux.
# Running the Prefect test harness within such a setup currently does not
# work due to lack of support for connecting to localhost when a network
# proxy is enabled. This workaround disables the Prefect test harness and
# use the IP v4 address of the host machine to connect to the API of a
# Prefect process running outside of the nono sandbox  (e.g. through
# `prefect server start --host 0.0.0.0`).
#
# For this file to be sourced, run `direnv` and add `source ./.envrc.local`
# to your `.envrc` file, both inside and outside of the nono sandbox.

export OMNIPY_NO_PREFECT_TEST_HARNESS=1

if [ ! -d "$DYN_WORKTREE_STATE_DIR/etc" ]; then
  mkdir -p "$DYN_WORKTREE_STATE_DIR/etc"
fi

if [ -z "$NONO_CAP_FILE" ]; then
  echo $(hostname -I | cut -d' ' -f1) > "$DYN_WORKTREE_STATE_DIR/etc/ipv4"
else
  export PREFECT_API_URL="http://$(cat "$DYN_WORKTREE_STATE_DIR/etc/ipv4"):4200/api"
fi